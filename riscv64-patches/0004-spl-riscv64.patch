+.macro SPL_SET_LVL lvl
+	la	t0, curr_ipl
+	lw	t1, 0(t0)		/* old ipl */
+	li	t2, \lvl
+	sw	t2, 0(t0)		/* curr_ipl = lvl */
+	beqz	\lvl, 8f
+	csrc	sstatus, SIE_BIT	/* disable S-mode interrupts */
+	j	9f
+8:	csrs	sstatus, SIE_BIT	/* enable S-mode interrupts */
+9:	mv	a0, t1		/* return old ipl */
+	ret
